# =====================================================================================
# .env.example : le modèle de TOUTES les variables de Citadel
# =====================================================================================
#
# Fichier public : aucun secret ici. Les vraies copies ne sont jamais versionnées :
#
#   Fichier                        Où        Sections
#   .env                           ton PC    1 et 2   le dev (serveur, front, base Docker)
#   .env.test                      ton PC    1 et 2   les tests d'intégration
#   /Volume1/citadel/.env.prod     le NAS    2 et 3   la prod : TOUT doit être rempli
#
# Pour créer .env.prod : copier les sections 2 et 3, puis remplir chaque ligne en suivant
# son commentaire. Une variable oubliée arrête `citadel deploy` avant tout changement,
# en donnant son nom : on ne casse rien en se trompant.
#
# Format : NOM=valeur, sans espace autour du « = » ni guillemets.
# [secret] : en prod, une valeur neuve, rangée dans Bitwarden AVANT d'être écrite ici.

# =====================================================================================
# 1. PC SEULEMENT (.env, .env.test)
# =====================================================================================
# En prod, compose.yml fixe lui-même ces valeurs : ne pas les mettre dans .env.prod.

# Port du serveur de dev Vite (le front)
CLIENT_DEV_PORT=3001
# Port d'écoute du serveur Express
SERVER_PORT=3000
# La base tourne dans Docker Desktop (compose.dev.yml), publiée sur ce port.
# Dans .env.test : DB_PORT=3308, base et compte citadel_test (le nom de la base doit
# finir par _test : les tests refusent de vider une autre base)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE_NAME=citadel_dev
DB_USER_NAME=citadel_dev
# true : le serveur affiche chaque requête SQL
LOG_DB=false
# .env.test seulement : graine de l'ordre aléatoire des tests d'intégration, pour rejouer
# un lancement. Vide : une graine neuve à chaque lancement
TEST_SEED=

# --- Mails ---
# Qui envoie les mails du site. journal : rien ne part, une ligne dans le log du serveur
# dit qu'un mail serait parti (sans son contenu) ; brevo : un vrai envoi, avec BREVO_API_KEY
# (section 2), pour tester la réception ; memory : dans .env.test seulement, les tests
# lisent les mails envoyés. En prod, compose.yml met brevo, et journal en pré-prod
MAIL_SENDER=journal
# Les réglages ci-dessous ont ces valeurs par défaut (env.ts du serveur), celles de la prod.
# Les seuils du quota quotidien de Brevo, en mails envoyés dans la journée. Atteints, les
# inscriptions, puis le formulaire de contact, puis tout le reste s'arrêtent. Les abaisser
# en dev pour voir le site fermer le formulaire (avec MAIL_SENDER=journal, le serveur
# compte lui-même ses envois)
MAIL_REGISTRATION_STOP=250
MAIL_CONTACT_STOP=280
MAIL_DAILY_LIMIT=300
# Messages du formulaire de contact par heure et par IP
CONTACT_HOURLY_LIMIT_PER_IP=5
# Crédits quotidiens de l'offre de Brevo (300 sur l'offre gratuite) : Brevo ne donne que
# ce qu'il en reste, le serveur en déduit les mails partis
BREVO_DAILY_CREDITS=300
# Le compteur de Brevo est relu au plus une fois par cette durée, en secondes
MAIL_QUOTA_READING_SECONDS=60
# Un échec d'envoi (table mailing_failure) est effacé après ce nombre de jours
MAIL_FAILURE_RETENTION_DAYS=90
# Les échecs de ces derniers jours sont signalés dans la console du NAS
MAIL_FAILURE_WINDOW_DAYS=7

# --- Authentification ---
# Durées et seuils de l'authentification. Dans .env.example, les valeurs de la prod
# (celles par défaut de env.ts, section auth) ; .env.test les garde, sauf un hash léger :
# les tests avancent l'horloge au lieu d'attendre.
# Sessions : 7 jours sans visite avec « se souvenir de moi », 12 h d'inactivité sans,
# 30 jours au plus ; dernière visite notée au plus toutes les 5 minutes
AUTH_SESSION_REMEMBER_DAYS=7
AUTH_SESSION_IDLE_HOURS=12
AUTH_SESSION_ABSOLUTE_DAYS=30
AUTH_SESSION_TOUCH_MINUTES=5
# false sur ton PC (http://localhost) : le cookie de session perd Secure et __Host-
AUTH_COOKIE_SECURE=true
# Interrupteur d'urgence des inscriptions
AUTH_REGISTRATION_ENABLED=true
# Durée de chaque parcours, en minutes
AUTH_REGISTRATION_MINUTES=30
AUTH_PASSWORD_RESET_MINUTES=15
AUTH_MAIL_LOGIN_MINUTES=15
AUTH_EMAIL_CHANGE_MINUTES=30
AUTH_SECOND_FACTOR_MINUTES=10
# Essais par code reçu par mail, délai avant un renvoi (secondes)
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_MAIL_RESEND_SECONDS=60
# Mails de l'authentification par adresse (par heure) et par IP (par heure, par jour)
AUTH_MAILS_PER_ADDRESS_PER_HOUR=5
AUTH_MAILS_PER_IP_PER_HOUR=20
AUTH_MAILS_PER_IP_PER_DAY=40
# Échecs de connexion : délai entre deux essais sur un compte (secondes), puis le couple
# compte + IP banni après 15 échecs, pour 15 minutes ; compteur remis à zéro après 15
# minutes de calme
AUTH_FAILURE_DELAY_SECONDS=2
AUTH_ACCOUNT_FAILURES_BEFORE_BAN=15
AUTH_ACCOUNT_BAN_MINUTES=15
AUTH_FAILURE_RESET_MINUTES=15
# Une IP bannie 15 minutes après 20 échecs en 10 minutes, ou plus de 3 inscriptions par heure
AUTH_IP_FAILURES_BEFORE_BAN=20
AUTH_IP_FAILURE_WINDOW_MINUTES=10
AUTH_IP_BAN_MINUTES=15
AUTH_REGISTRATIONS_PER_IP_PER_HOUR=3
# Coût d'un hash de mot de passe argon2id (minimum OWASP : 19456 Kio, 2 passes, 1 fil),
# puis hashs simultanés et en attente au plus (le serveur n'a que 256 Mo)
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_PASSES=2
AUTH_ARGON2_PARALLELISM=1
AUTH_HASH_CONCURRENCY=2
AUTH_HASH_QUEUE_MAX=20
# Double authentification : nom affiché par l'application d'authentification, pas de
# 30 secondes tolérés avant et après, nombre de codes de secours
AUTH_TOTP_ISSUER=Citadel
AUTH_TOTP_DRIFT_STEPS=1
AUTH_RECOVERY_CODES_COUNT=10
# Un facteur ajouté dont le premier code n'est pas validé dans ce délai (minutes) est effacé
AUTH_FACTOR_CONFIRMATION_MINUTES=15
# Conservation, en jours : événements de sécurité, erreurs du serveur (avec les 10
# semaines des sauvegardes, moins de 3 mois), journal de restauration
AUTH_EVENT_RETENTION_DAYS=20
ERROR_LOG_RETENTION_DAYS=20
AUTH_RESTORE_JOURNAL_DAYS=70
# Purge des parcours, des sessions et des facteurs non confirmés expirés, toutes les
# 15 minutes ; celle des événements de sécurité et des erreurs, une fois par jour
AUTH_PURGE_INTERVAL_MINUTES=15

# =====================================================================================
# 2. PC ET NAS : mêmes noms, valeurs différentes
# =====================================================================================

# --- IGDB, pour le Backlog ---
# Ton application Twitch (dev.twitch.tv) : le serveur en tire lui-même ses tokens IGDB
# et les renouvelle quand ils expirent. Dans .env.test, n'importe quelles valeurs :
# les tests d'intégration simulent IGDB
INTERNET_GAME_DATA_BASE_CLIENT_ID=
# [secret] Le « Client Secret » de l'application (« New Secret » sur dev.twitch.tv)
INTERNET_GAME_DATA_BASE_CLIENT_SECRET=

# --- Base de données : mots de passe ---
# Sur ton PC, ceux de ta base Docker jetable. En prod, neufs.
# [secret] Le compte du serveur (citadel_app en prod) : lire et écrire les données
DB_USER_PASSWORD=
# [secret] root : seulement depuis l'intérieur du conteneur de la base
DB_ROOT_PASSWORD=

# --- Mails : Brevo ---
# [secret] Clé d'API de Brevo (SMTP et API, Clés API), qui envoie les mails du site.
# Restreinte : « Emails transactionnels » en Tous, « Compte » en Lues. Lue seulement avec
# MAIL_SENDER=brevo : vide dans .env.test (expéditeur en mémoire), et jamais donnée à la
# pré-prod ni à `pnpm prod:local`
BREVO_API_KEY=

# --- Authentification : clés ---
# Chacune : `openssl rand -hex 32` (Git Bash). Sur ton PC et dans .env.test, des
# valeurs quelconques de ce format.
# [secret] Clé des empreintes HMAC des codes envoyés par mail
AUTH_CODE_HMAC_KEY=
# [secret] Clé de chiffrement des secrets de double authentification (TOTP)
AUTH_TOTP_ENCRYPTION_KEY=
# Sa version, gardée avec chaque secret chiffré : +1 à chaque nouvelle clé
AUTH_TOTP_ENCRYPTION_KEY_VERSION=1
# [secret] Pendant une rotation seulement : l'ancienne clé, qui déchiffre les secrets de
# la version précédente le temps qu'ils soient rechiffrés. Vide sinon
AUTH_TOTP_PREVIOUS_ENCRYPTION_KEY=

# =====================================================================================
# 3. NAS SEULEMENT (.env.prod)
# =====================================================================================

# --- 3.1 La machine : des numéros lus sur le NAS, pas des secrets ---
# Propriétaire des dossiers de la stack média (/Volume1/appdata, /Volume2/data), sous
# lequel tournent qBittorrent, Jellyfin et les *arr : `stat -c '%u %g' /Volume1/appdata/radarr`
# donne PUID puis PGID
PUID=
PGID=
# Le groupe qui a droit à la puce graphique, pour le transcodage de Jellyfin :
# `getent group render | cut -d: -f3`
RENDER_GROUP=
# Le groupe propriétaire du socket de Docker, pour le filtre de la console :
# `stat -c %g /var/run/docker.sock`
DOCKER_GID=
# Le réseau local, que Gluetun laisse joignable depuis le VPN : 192.168.x.0/24, celui
# de ta box
LAN_SUBNET=
# Le nom du NAS dans ton tailnet (celui de ton alias ssh nas) : Tailscale l'annonce
NAS_HOSTNAME=

# --- 3.2 Base de données : les deux autres comptes ---
# [secret] Flyway, et toi dans DBeaver : structure et données de la base
DB_MIGRATOR_PASSWORD=
# [secret] Les dumps : lecture seule
DB_BACKUP_PASSWORD=

# --- 3.3 HTTPS : certificats de Caddy ---
# Ton adresse, donnée à Let's Encrypt pour le compte des certificats
ACME_EMAIL=
# [secret] Jeton d'API Cloudflare limité au DNS de ton domaine
CLOUDFLARE_API_TOKEN=

# --- 3.4 VPN : Gluetun ---
# [secret] Clé privée WireGuard de ProtonVPN
WIREGUARD_PRIVATE_KEY=
# [secret] Clé que la console présente à Gluetun pour lire l'IP du VPN et le port
# redirigé. Une chaîne au hasard : `openssl rand -hex 24` (Git Bash)
GLUETUN_API_KEY=

# --- 3.5 Console d'administration ---
# Le hachage du mot de passe de la console, jamais le mot de passe. `pnpm admin:password`
# sur ton PC le demande et écrit la ligne entière à coller ici. Le mot de passe va dans
# Bitwarden.
ADMIN_PASSWORD_HASH=
# Ton compte qBittorrent, celui de son interface : la console y lit vitesses et ratio
QBITTORRENT_USER=
# [secret]
QBITTORRENT_PASSWORD=
# [secret] Pour les lectures en cours. Dans Jellyfin : Tableau de bord, Clés API, « + »,
# nom « citadel-console ». Une clé donne les droits d'administrateur : Bitwarden
JELLYFIN_API_KEY=

# --- 3.6 Alertes ---
# [secret] La « clé de ping » de ton projet healthchecks.io (Settings, « Ping key ») :
# chaque job y signale sa réussite ou son échec, sous son nom (README, « Alertes »)
HEALTHCHECKS_PING_KEY=
