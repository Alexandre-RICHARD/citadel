# Modèle de TOUTES les variables de Citadel. Fichier public : aucune vraie valeur ici.
# Copies réelles, jamais versionnées : .env (dev) et .env.test (tests) sur ton PC
# → sections SITE ; .env.prod sur le NAS → toutes les sections.
# Format : NOM=valeur, sans espace autour du « = » ni guillemets.

# ===== SITE =====
# Port du serveur de dev Vite (le front)
CLIENT_DEV_PORT=3001
# Port d'écoute du serveur Express
SERVER_PORT=3000
# Proxy IGDB du Backlog (POC) : le token expire, à remplacer à la main
INTERNET_GAME_DATA_BASE_CLIENT_ID=
INTERNET_GAME_DATA_BASE_TOKEN=
# En prod, hôte, base et compte sont fixés par compose.yml : seuls les mots de passe viennent d'ici.
# Sur ton PC, la base tourne dans Docker (compose.dev.yml), publiée sur ce port.
# Dans .env.test : DB_PORT=3308, base et compte citadel_test (le nom de la base doit finir par _test).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE_NAME=citadel_dev
DB_USER_NAME=citadel_dev
DB_USER_PASSWORD=
DB_ROOT_PASSWORD=
# true : le serveur affiche chaque requête SQL
LOG_DB=false
# .env.test seulement : graine de l'ordre aléatoire des tests d'intégration, pour rejouer un lancement.
# Vide : une graine neuve à chaque lancement
TEST_SEED=

# ===== NAS =====
# .env.prod seulement : lues par infra/compose.yml. Mots de passe neufs, rangés dans Bitwarden.
# Comptes de la base (§12.5) : Flyway et DBeaver ; les dumps, en lecture seule
DB_MIGRATOR_PASSWORD=
DB_BACKUP_PASSWORD=
# Jeton d'API Cloudflare limité au DNS du domaine : Caddy obtient ses certificats avec
CLOUDFLARE_API_TOKEN=
# Adresse donnée à Let's Encrypt pour le compte des certificats
ACME_EMAIL=
# Stack média : l'utilisateur et le groupe du NAS propriétaires de /Volume1/appdata et
# /Volume2/data (`id` sur le NAS), et le groupe « render » qui a accès au GPU
# (`getent group render`), pour le transcodage de Jellyfin
PUID=
PGID=
RENDER_GROUP=
# Clé privée WireGuard de ProtonVPN, pour Gluetun
WIREGUARD_PRIVATE_KEY=
