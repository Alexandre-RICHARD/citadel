# =====================================================================================
# .env.example : le modèle de TOUTES les variables de Citadel
# =====================================================================================
#
# Fichier public : aucun secret ici. Les vraies copies ne sont jamais versionnées :
#
#   Fichier                        Où        Sections
#   .env                           ton PC    1 et 2   le dev (serveur, front, base Docker)
#   .env.test                      ton PC    1 et 2   les tests d'intégration
#   /Volume1/citadel/.env.prod     le NAS    2 et 3   la prod : TOUT doit être rempli
#
# Pour créer .env.prod : copier les sections 2 et 3, puis remplir chaque ligne en suivant
# son commentaire. Une variable oubliée arrête `citadel deploy` avant tout changement,
# en donnant son nom : on ne casse rien en se trompant.
#
# Format : NOM=valeur, sans espace autour du « = » ni guillemets.
# [secret] : en prod, une valeur neuve, rangée dans Bitwarden AVANT d'être écrite ici.

# =====================================================================================
# 1. PC SEULEMENT (.env, .env.test)
# =====================================================================================
# En prod, compose.yml fixe lui-même ces valeurs : ne pas les mettre dans .env.prod.

# Port du serveur de dev Vite (le front)
CLIENT_DEV_PORT=3001
# Port d'écoute du serveur Express
SERVER_PORT=3000
# La base tourne dans Docker Desktop (compose.dev.yml), publiée sur ce port.
# Dans .env.test : DB_PORT=3308, base et compte citadel_test (le nom de la base doit
# finir par _test : les tests refusent de vider une autre base)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE_NAME=citadel_dev
DB_USER_NAME=citadel_dev
# true : le serveur affiche chaque requête SQL
LOG_DB=false
# .env.test seulement : graine de l'ordre aléatoire des tests d'intégration, pour rejouer
# un lancement. Vide : une graine neuve à chaque lancement
TEST_SEED=

# =====================================================================================
# 2. PC ET NAS : mêmes noms, valeurs différentes
# =====================================================================================

# --- Proxy IGDB du Backlog (POC) ---
# Ton application Twitch (dev.twitch.tv). Le token expire : à remplacer à la main
# (la console affiche sa date, rubrique Échéances)
INTERNET_GAME_DATA_BASE_CLIENT_ID=
# [secret]
INTERNET_GAME_DATA_BASE_TOKEN=

# --- Base de données : mots de passe ---
# Sur ton PC, ceux de ta base Docker jetable. En prod, neufs.
# [secret] Le compte du serveur (citadel_app en prod) : lire et écrire les données
DB_USER_PASSWORD=
# [secret] root : seulement depuis l'intérieur du conteneur de la base
DB_ROOT_PASSWORD=

# =====================================================================================
# 3. NAS SEULEMENT (.env.prod)
# =====================================================================================

# --- 3.1 La machine : des numéros lus sur le NAS, pas des secrets ---
# Propriétaire des dossiers de la stack média (/Volume1/appdata, /Volume2/data), sous
# lequel tournent qBittorrent, Jellyfin et les *arr : `stat -c '%u %g' /Volume1/appdata/radarr`
# donne PUID puis PGID (1004 1004 sur ton NAS)
PUID=
PGID=
# Le groupe qui a droit à la puce graphique, pour le transcodage de Jellyfin :
# `getent group render | cut -d: -f3` (109 sur ton NAS)
RENDER_GROUP=
# Le groupe propriétaire du socket de Docker, pour le filtre de la console :
# `stat -c %g /var/run/docker.sock` (0 sur ton NAS)
DOCKER_GID=

# --- 3.2 Base de données : les deux autres comptes (§12.5) ---
# [secret] Flyway, et toi dans DBeaver : structure et données de la base
DB_MIGRATOR_PASSWORD=
# [secret] Les dumps : lecture seule
DB_BACKUP_PASSWORD=

# --- 3.3 HTTPS : certificats de Caddy ---
# Ton adresse, donnée à Let's Encrypt pour le compte des certificats
ACME_EMAIL=
# [secret] Jeton d'API Cloudflare limité au DNS de ton domaine (§12.3)
CLOUDFLARE_API_TOKEN=

# --- 3.4 VPN : Gluetun ---
# [secret] Clé privée WireGuard de ProtonVPN
WIREGUARD_PRIVATE_KEY=
# [secret] Clé que la console présente à Gluetun pour lire l'IP du VPN et le port
# redirigé. Une chaîne au hasard : `openssl rand -hex 24` (Git Bash)
GLUETUN_API_KEY=

# --- 3.5 Console d'administration ---
# Le hachage du mot de passe de la console, jamais le mot de passe. `pnpm admin:password`
# sur ton PC le demande et écrit la ligne entière à coller ici. Le mot de passe va dans
# Bitwarden.
ADMIN_PASSWORD_HASH=
# Ton compte qBittorrent, celui de son interface : la console y lit vitesses et ratio
QBITTORRENT_USER=
# [secret]
QBITTORRENT_PASSWORD=
# [secret] Pour les lectures en cours. Dans Jellyfin : Tableau de bord, Clés API, « + »,
# nom « citadel-console ». Une clé donne les droits d'administrateur : Bitwarden
JELLYFIN_API_KEY=
