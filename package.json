{
  "name": "citadel-monorepo",
  "type": "module",
  "author": "Alexandre RICHARD",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "scripts": {
    "=== Dev ===": "",
    "dev-all": "pnpm --parallel --filter \"./apps/*\" dev",
    "=== Bases locales (Docker Desktop, compose.dev.yml) ===": "",
    "db:up": "bash scripts/docker/devDatabase.sh up",
    "db:migrate": "bash scripts/docker/devDatabase.sh migrate",
    "db:down": "bash scripts/docker/devDatabase.sh down",
    "db:reset": "bash scripts/docker/devDatabase.sh reset",
    "=== Validation ===": "",
    "lint": "pnpm -r lint",
    "lint-fix": "pnpm -r lint-fix",
    "check-types": "pnpm -r check-types",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "validate-all": "bash scripts/validation/validateAll.sh",
    "test-report": "vitest run --config vitest.report.config.ts && vite preview --outDir report --open",
    "=== Build & Production ===": "",
    "build": "pnpm --filter \"./apps/*\" build",
    "prod:local": "bash scripts/docker/localStack.sh prod up",
    "prod:local:down": "bash scripts/docker/localStack.sh prod down",
    "=== Packages ===": "",
    "install-dependencies": "pnpm i",
    "update-minor": "pnpm update --recursive --interactive",
    "update-major": "pnpm update --recursive --interactive --latest",
    "=== Scripts ===": "",
    "tools": "bash scripts/run.sh"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
