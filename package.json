{
  "name": "citadel-monorepo",
  "type": "module",
  "author": "Alexandre RICHARD",
  "private": true,
  "version": "1.0.0",
  "license": "ISC",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "scripts": {
    "=== Dev ===": "",
    "dev-all": "pnpm --parallel --filter \"./apps/*\" dev",
    "=== Validation ===": "",
    "lint": "pnpm -r lint",
    "lint-fix": "pnpm -r lint-fix",
    "check-types": "pnpm -r check-types",
    "validate-all": "pnpm -r validate-all",
    "test-report": "vitest run --reporter=html --coverage.enabled=true && vite preview --outDir report --open",
    "=== Build & Production ===": "",
    "build": "pnpm --filter \"./apps/*\" build",
    "=== Packages ===": "",
    "install-dependencies": "pnpm i",
    "update-minor": "pnpm update --recursive --interactive",
    "update-major": "pnpm update --recursive --interactive --latest"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
