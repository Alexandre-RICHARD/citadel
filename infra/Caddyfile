# =====================================================================================
# Caddyfile : la porte d'entrée web du NAS
# =====================================================================================
#
# Copié dans l'image « caddy » à sa construction (Dockerfile) : une règle modifiée part
# en prod avec la version suivante, comme le code.
#
# Le chemin d'une requête :
#   visiteur → Cloudflare (sauf Jellyfin) → box (443 → 4443 du NAS) → infra-caddy
#            → le bon conteneur, choisi selon le nom de domaine et le chemin.
# Caddy obtient et renouvelle seul les certificats HTTPS (Let's Encrypt).
#
# Syntaxe : `{$NOM}` est remplacé au démarrage par la variable d'environnement NOM
# (fournie par compose.yml), `{$NOM:défaut}` prend « défaut » si elle est absente.
# SITE_DOMAIN n'est pas définie en prod : le domaine est alexandre-richard.fr.
# `pnpm prod:local` la met à citadel.localhost, pour tester ces règles sur ton PC.

# --- Options globales ---
{
	# Adresse donnée à Let's Encrypt pour le compte ACME
	email {$ACME_EMAIL}

	# Certificats par l'API DNS de Cloudflare (le « challenge DNS ») : Caddy prouve qu'il
	# contrôle le domaine en créant un enregistrement DNS temporaire. C'est la méthode
	# fiable derrière le proxy de Cloudflare, qui intercepte les autres. Le jeton n'a le
	# droit que de modifier le DNS de ton domaine.
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}

	servers {
		# Derrière Cloudflare, la connexion vient d'un serveur de Cloudflare : l'IP du
		# visiteur est dans l'en-tête CF-Connecting-IP. Caddy ne croit cet en-tête que
		# s'il arrive d'une adresse de Cloudflare (liste mise à jour toutes les 12 h par
		# le module caddy-cloudflare-ip) : un visiteur direct ne peut pas se faire passer
		# pour un autre. L'IP réelle sert aux logs et à la console.
		trusted_proxies cloudflare {
			interval 12h
			timeout 15s
		}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# --- Blocs réutilisés plus bas avec `import` ---
(security_headers) {
	header {
		# HTTPS obligatoire pour ce nom pendant un an, même si on tape http://
		Strict-Transport-Security "max-age=31536000"
		# Le navigateur ne devine pas le type d'un fichier : il suit Content-Type
		X-Content-Type-Options "nosniff"
		# Les autres sites ne voient que le domaine d'où vient le visiteur, pas la page
		Referrer-Policy "strict-origin-when-cross-origin"
		# Le site ne peut pas être affiché dans un cadre d'un autre site (anti-clickjacking)
		X-Frame-Options "SAMEORIGIN"
		# Ne pas annoncer « Caddy » dans les réponses
		-Server
	}
}

# La Content-Security-Policy : dit au navigateur d'où la page a le droit de charger
# ses scripts, styles, images et connexions. Un script injecté par une faille (XSS) vient
# d'ailleurs, ou est écrit dans la page : le navigateur le refuse. C'est la seconde
# barrière, après l'échappement du contenu par React. Pour le site seulement : Jellyfin a
# ses propres scripts, qu'elle casserait.
# style-src-attr : les attributs style="…" que posent la carte (Leaflet : icônes des bus) ; les
# feuilles de style restent limitées au site. Un attribut style ne peut pas exécuter de script.
# Un site qui charge quelque chose d'une source non listée ici le voit bloqué sans bruit
# (seulement une erreur dans la console du navigateur) : toute nouvelle source externe
# (images, cartes, API) s'ajoute à la ligne qui lui correspond, puis se teste avec
# `pnpm prod:local`.
(content_security_policy) {
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: https://images.igdb.com https://tile.openstreetmap.org; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
}

# L'IP du visiteur, transmise au serveur Express. {client_ip} est celle que Caddy a validée
# (trusted_proxies, plus haut) : derrière Cloudflare, le CF-Connecting-IP d'une adresse de
# Cloudflare ; sinon, l'adresse de la connexion. `header_up` ÉCRASE l'en-tête : un visiteur
# qui enverrait son propre X-Real-IP ne peut pas se faire passer pour un autre. Le serveur,
# joignable seulement par Caddy (réseau Docker), ne lit que cet en-tête : les limites du
# formulaire de contact (messages par heure et par IP) en dépendent. Sans lui, tous les
# visiteurs auraient l'IP de Caddy, et se partageraient la même limite.
(real_ip) {
	header_up X-Real-IP {client_ip}
}

(access_log) {
	# Une ligne JSON par requête sur la sortie standard du conteneur : la console la lit
	# (accès externes, scans suspects). Les messages de Caddy lui-même vont sur la
	# sortie d'erreur. La rotation est réglée par Docker.
	log {
		output stdout
		# Sans les en-têtes de la requête et de la réponse ni le détail TLS : les trois
		# quarts de chaque ligne, inutiles à la console. Restent l'IP, la méthode, le
		# nom, le chemin, le code de réponse, la taille et la durée.
		format filter {
			fields {
				request>headers delete
				request>tls delete
				resp_headers delete
			}
			wrap json
		}
	}
	# Le pays du visiteur, donné par Cloudflare (vide pour Jellyfin, hors Cloudflare)
	log_append country {http.request.header.Cf-Ipcountry}
}

# ===== Le site : la box envoie 80/443 vers les ports 8001/4443 du NAS =====
{$SITE_DOMAIN:alexandre-richard.fr} {
	import security_headers
	import content_security_policy
	import access_log
	# Compression des réponses, si le navigateur l'accepte
	encode zstd gzip

	# Le mode maintenance : state/public/maintenance.on existe (la console, ou
	# `citadel maintenance on`). Caddy regarde le fichier à chaque requête : rien à
	# recharger. /api/health reste ouvert : site-check vérifie toujours le serveur.
	@maintenance {
		file {
			root /srv/public
			try_files /maintenance.on
		}
		not path /api/health
	}

	# `route` garde l'ordre écrit ici : la maintenance passe avant /api. Les `handle`
	# sont exclusifs : la première qui correspond répond, les suivantes sont ignorées.
	route {
		# Le bandeau du site : un fichier écrit par infra-ops, servi tel quel.
		# Absent : 404, et le front n'affiche rien. Jamais gardé en cache.
		handle /banner.json {
			root * /srv/public
			header Cache-Control "no-store"
			file_server
		}

		handle @maintenance {
			root * /srv/maintenance
			rewrite * /index.html
			header Cache-Control "no-store"
			file_server {
				status 503
			}
		}

		# /api/internal/… : les routes du serveur réservées à la console du NAS (le nombre de
		# mails qui n'ont pas pu partir…). La console appelle le serveur directement, par le
		# réseau Docker, sans passer par ici : depuis Internet, ces routes n'existent pas. Le
		# serveur les refuse aussi de son côté, à toute requête qui porte le X-Real-IP de Caddy.
		handle /api/internal/* {
			respond 404
		}

		# /api/… va au serveur, préfixe retiré : /api/health arrive en /health.
		# Les routes du serveur ne changent donc pas, et le front appelle /api partout.
		handle_path /api/* {
			reverse_proxy site-prod-server:3000 {
				import real_ip
			}
		}

		# Tout le reste va au nginx du front : fichiers du site, /irigo
		handle {
			reverse_proxy site-prod-client:8080
		}
	}
}

# ===== La pré-prod : http://<NAS>:8002, en LAN et par Tailscale seulement =====
# La box n'envoie jamais ce port : invisible depuis Internet. En HTTP, sans certificat,
# comme la console. Arrêtée la plupart du temps : Caddy répond alors 502.
http://:8002 {
	encode zstd gzip
	# Comme en prod : les routes internes ne passent pas par Caddy. Ce `handle`, plus précis
	# que /api/*, passe avant lui (Caddy trie les `handle` par longueur de chemin)
	handle /api/internal/* {
		respond 404
	}
	handle_path /api/* {
		reverse_proxy site-preprod-server:3000 {
			import real_ip
		}
	}
	handle {
		reverse_proxy site-preprod-client:8080
	}
}

# www. renvoie vers le domaine sans www., en gardant le chemin
www.{$SITE_DOMAIN:alexandre-richard.fr} {
	redir https://{$SITE_DOMAIN:alexandre-richard.fr}{uri} permanent
}

# ===== Jellyfin : seul service média exposé, sans le proxy de Cloudflare =====
# Nom repris de NPM. Caddy et Jellyfin partagent le réseau Docker « edge » (compose.yml).
# Jellyfin arrêté (il est « à la demande ») : Caddy répond 502, et rien d'autre ne casse.
jellyfin.{$SITE_DOMAIN:alexandre-richard.fr} {
	import security_headers
	import access_log
	reverse_proxy media-jellyfin:8096
}
