# Valeurs pour `pnpm prod:local` (infra/compose.local.yml) : de quoi remplir les ${…} de
# compose.yml sur ton PC, dans l'ordre de .env.example. Versionné, car rien ici n'est
# secret : tout est jetable et ne répond que sur 127.0.0.1 de ton PC.
# Le .env de la racine est lu en premier : ses identifiants IGDB (section 2) vont au
# serveur, qui appelle IGDB lui-même (recherche et ajout de jeux du Backlog).

# Le tag de nos images construites en local (compose.local.yml)
CITADEL_VERSION=local
# Domaine de test : Caddy le sert avec ses propres certificats, sans Let's Encrypt
SITE_DOMAIN=citadel.localhost

# --- 2. Base de données : mots de passe de la base de test ---
DB_USER_PASSWORD=local-app
DB_ROOT_PASSWORD=local-root

# --- 2. Mails : remplace la vraie clé du .env, lu avant ce fichier. Jamais utilisée :
# compose.local.yml met le serveur en MAIL_SENDER=journal, rien ne part vers Brevo
BREVO_API_KEY=local-never-sent-to-brevo

# --- 3.1 La machine ---
# L'utilisateur des images linuxserver dans les volumes de test
PUID=1000
PGID=1000
# Jamais utilisé en local : pas de transcodage matériel
RENDER_GROUP=0
# Le socket de Docker Desktop appartient au groupe root (0)
DOCKER_GID=0
# Le faux Gluetun ne s'en sert pas, Tailscale ne tourne pas : des valeurs de forme
LAN_SUBNET=192.168.0.0/24
NAS_HOSTNAME=citadel-local

# --- 3.2 Base de données : les deux autres comptes ---
DB_MIGRATOR_PASSWORD=local-migrator
DB_BACKUP_PASSWORD=local-backup

# --- 3.3 HTTPS ---
ACME_EMAIL=test@citadel.localhost
# Jamais utilisé (pas de Let's Encrypt en local), mais le module Cloudflare de Caddy
# vérifie qu'il a la forme d'un vrai jeton : 40 caractères
CLOUDFLARE_API_TOKEN=local-test-token-never-sent-to-cloudflare

# --- 3.4 VPN : un faux Gluetun, sans VPN ni clé ---
WIREGUARD_PRIVATE_KEY=local-fake-key-no-vpn-on-this-pc
GLUETUN_API_KEY=local-fake-gluetun-key

# --- 3.5 Console ---
# Mot de passe « admin » (hachage fait avec pnpm admin:password)
ADMIN_PASSWORD_HASH=argon2id:m=19456,t=2,p=1:ZmF9TD5kdAFGcr-YNA4yrg:tOKWVizacgdfIk4ntNgA4dz9O9kvLIMRLzZih5KV3UI
# Le compte du qBittorrent de test (compose.local.yml)
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=adminadmin
# Le Jellyfin de test démarre sans compte ni clé : la console affiche « clé refusée »
JELLYFIN_API_KEY=local-no-key

# --- 3.6 Alertes ---
# Jamais utilisée : compose.local.yml la vide pour infra-ops, rien ne part
HEALTHCHECKS_PING_KEY=local-never-used
