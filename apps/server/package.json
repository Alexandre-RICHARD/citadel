{
  "name": "@citadel/server",
  "type": "module",
  "scripts": {
    "=== Dev ===": "",
    "dev": "tsx watch --env-file-if-exists=../../.env ./src/index.ts",
    "=== Validation ===": "",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "check-types": "tsc --noEmit",
    "test-unit": "vitest run",
    "test-integration": "vitest run --config vitest.integration.config.ts",
    "=== Build & Production ===": "",
    "build": "node esbuildConfig.mjs",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps ./build/build.server.cjs",
    "after-restore": "node --env-file-if-exists=../../.env --enable-source-maps ./build/afterRestore.cjs"
  },
  "dependencies": {
    "@citadel/common": "workspace:*",
    "@citadel/specs": "workspace:*",
    "express": "catalog:",
    "mariadb": "^3.5.4",
    "sequelize": "6.37.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@citadel/eslint-config": "workspace:*",
    "@citadel/typescript-config": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "supertest": "^7.3.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
