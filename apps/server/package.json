{
  "name": "@citadel/server",
  "type": "module",
  "scripts": {
    "=== Dev ===": "",
    "dev": "tsx watch --env-file-if-exists=../../.env ./src/index.ts",
    "init-db": "bash ./scripts/init_db.sh",
    "migrate": "bash ./scripts/flyway_local.sh",
    "=== Validation ===": "",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "check-types": "tsc --noEmit",
    "unit-test-once": "vitest run",
    "unit-test-watch": "vitest watch",
    "integration-test": "vitest run --config vitest.integration.config.ts",
    "validate-all": "pnpm check-types && pnpm lint-fix && pnpm unit-test-once && pnpm integration-test && pnpm build",
    "=== Build & Production ===": "",
    "build": "node esbuildConfig.mjs",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps ./build/build.server.cjs"
  },
  "dependencies": {
    "@citadel/common": "workspace:*",
    "@citadel/specs": "workspace:*",
    "express": "^5.1.0",
    "mariadb": "^3.5.4",
    "sequelize": "6.37.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@citadel/eslint-config": "workspace:*",
    "@citadel/typescript-config": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "eslint": "catalog:",
    "globals": "catalog:",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
