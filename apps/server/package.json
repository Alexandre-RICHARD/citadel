{
  "name": "@citadel/server",
  "type": "module",
  "scripts": {
    "=== Dev ===": "",
    "dev": "tsx watch ./src/index.ts",
    "init-db": "bash ./scripts/init_db.sh",
    "migrate": "bash ./scripts/flyway_local.sh",
    "=== Validation ===": "",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "check-types": "tsc --noEmit",
    "unit-test-once": "vitest run --mode dev",
    "unit-test-watch": "vitest watch --mode dev",
    "unit-test-report": "vitest run --mode dev --reporter=html --coverage.enabled=true && vite preview --outDir report --open",
    "validate-all": "pnpm check-types && pnpm lint-fix && pnpm unit-test-once",
    "=== Build & Production ===": "",
    "build": "node esbuild.config.mjs",
    "start": "node ./build/build.server.js"
  },
  "dependencies": {
    "@citadel/specs": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "mariadb": "^3.5.4",
    "sequelize": "6.37.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@citadel/eslint-config": "workspace:*",
    "@citadel/typescript-config": "workspace:*",
    "@stylistic/eslint-plugin": "catalog:",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "esbuild": "^0.28.2",
    "eslint": "catalog:",
    "eslint-config-airbnb-base": "catalog:",
    "eslint-config-airbnb-typescript": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "eslint-plugin-vitest": "0.5.4",
    "globals": "catalog:",
    "prettier": "catalog:",
    "sequelize-cli": "^6.6.3",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
