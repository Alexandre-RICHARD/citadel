{
  "name": "alex_front",
  "type": "module",
  "version": "0.0.0",
  "main": "src/main.tsx",
  "author": "Alexandre RICHARD",
  "license": "ISC",
  "types": "module",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "scripts": {
    "=== Dev ===": "",
    "start": "vite --open",
    "start-host": "vite --open --host",
    "=== Lint & Tests ===": "",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "check-types": "tsc --noEmit",
    "unit-test-once": "vitest run",
    "unit-test-watch": "vitest watch",
    "unit-test-report": "vitest run --reporter=html --coverage.enabled=true && vite preview --outDir report --open",
    "validate-all": "pnpm check-types && pnpm lint-fix && pnpm unit-test-once && pnpm build",
    "=== Build & Production ===": "",
    "build": "tsc --build && vite build",
    "preview": "vite preview --open",
    "=== Packages ===": "",
    "install-dependencies": "pnpm i",
    "update-dep-minor": "pnpm update",
    "update-dep-major": "pnpm update --interactive --latest",
    "update-submodules": "git submodule update --init --recursive"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "vis-data": "^8.0.5",
    "vis-network": "^10.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.103.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
