{
  "name": "@citadel/client",
  "type": "module",
  "scripts": {
    "=== Dev ===": "",
    "dev": "vite --open",
    "=== Validation ===": "",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "check-types": "tsc --noEmit",
    "unit-test-once": "vitest run",
    "unit-test-watch": "vitest watch",
    "validate-all": "pnpm check-types && pnpm lint-fix && pnpm unit-test-once && pnpm build",
    "=== Build & Production ===": "",
    "build": "tsc --build && vite build",
    "start": "vite preview --open"
  },
  "dependencies": {
    "@citadel/common": "workspace:*",
    "@citadel/design-system": "workspace:*",
    "@citadel/specs": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "catalog:",
    "protobufjs": "^8.8.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.4.0",
    "vis-data": "^8.0.5",
    "vis-network": "^10.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@citadel/eslint-config": "workspace:*",
    "@citadel/typescript-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
