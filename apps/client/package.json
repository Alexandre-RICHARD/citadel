{
  "name": "@citadel/client",
  "type": "module",
  "scripts": {
    "=== Dev ===": "",
    "dev": "vite --open --port 3001",
    "=== Validation ===": "",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "check-types": "tsc --noEmit",
    "unit-test-once": "vitest run",
    "unit-test-watch": "vitest watch",
    "unit-test-report": "vitest run --reporter=html --coverage.enabled=true && vite preview --outDir report --open",
    "validate-all": "pnpm check-types && pnpm lint-fix && pnpm unit-test-once && pnpm build",
    "=== Build & Production ===": "",
    "build": "tsc --build && vite build",
    "start": "vite preview --open"
  },
  "dependencies": {
    "@citadel/design-system": "workspace:*",
    "@citadel/specs": "workspace:*",
    "@tanstack/react-query": "^5.103.2",
    "lucide-react": "^1.48.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^8.4.0",
    "vis-data": "^8.0.5",
    "vis-network": "^10.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@citadel/eslint-config": "workspace:*",
    "@citadel/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint": "catalog:",
    "jsdom": "^30.1.1",
    "sass-embedded": "^1.105.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
