{
	"extends": "@citadel/typescript-config/tsconfig.json",
	"compilerOptions": {
		"moduleResolution": "bundler",
		"module": "esnext",
		"target": "esnext",
		"jsx": "react-jsx",
		"tsBuildInfoFile": "tsBuildInfo.json",
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ESNext"
		],
		"paths": {
			"@/*": [
				"./src/*"
			],
			"@styles/*": [
				"./src/styles/*"
			]
		}
	},
	"include": [
		"src",
		"**/*.d.ts",
		"vite.config.ts",
		"vitest.config.ts",
		"vitestSetup.ts",
		"eslint.config.js",
	],
	"exclude": [
		"build",
		"node_modules",
		"report",
		"src/todo_folder" // TODO 
	]
}
